# Copy this file to .env and add your keys. fetch_data.py reads .env at start.
# A variable that is already set in the shell has priority over the value in .env.

# Massive (formerly Polygon.io). Option prices for the implied volatility of strategy C.
# Free key: https://massive.com (free tier: end-of-day option prices, 5 requests a minute).
MASSIVE_API_KEY=

# Alpha Vantage. Optional third source for dividend dates.
# Free key: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
